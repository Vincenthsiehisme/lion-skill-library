---
import Layout from '../layouts/Layout.astro';

// GAS Web App URL 直接寫在頁面下方的 <script> 內,
// 因為 client-side script 跟 frontmatter 不互通。
---

<Layout title="Wishlist" description="社群投票決定下一個要做的 skill">
  <div class="container">
    <header class="detail-header">
      <div class="hero__kicker">Community wishlist</div>
      <h1 class="detail-title">Skill Wishlist</h1>
      <p class="detail-description">
        覺得需要什麼 skill?提出來、投上去。每週日 23:59 結算,Top 3 進入排程,
        會出現在首頁的「準備中」清單。
      </p>
      <div class="hero__meta" id="week-info">載入中…</div>
    </header>

    <nav class="filter-bar" role="tablist" aria-label="Wishlist tabs">
      <button type="button" class="filter-btn is-active" data-tab="vote" role="tab" aria-selected="true">
        投票
      </button>
      <button type="button" class="filter-btn" data-tab="propose" role="tab" aria-selected="false">
        提案
      </button>
      <button type="button" class="filter-btn" data-tab="results" role="tab" aria-selected="false">
        歷史結果
      </button>
    </nav>

    <!-- ============== 投票 tab ============== -->
    <section id="tab-vote" class="wishlist-section">
      <div class="vote-layout">
        <!-- ----- 主欄 ----- -->
        <div class="vote-main">
          <div class="vote-toolbar" id="vote-toolbar" hidden>
            <div class="vote-toolbar__hint">
              <span id="vote-stats">—</span>
            </div>
            <div class="vote-toolbar__sort" role="tablist" aria-label="排序方式">
              <button type="button" class="sort-btn is-active" data-sort="votes" role="tab" aria-selected="true">
                票數
              </button>
              <button type="button" class="sort-btn" data-sort="newest" role="tab" aria-selected="false">
                最新
              </button>
            </div>
          </div>

          <div id="items-list" class="wishlist-items">
            <p class="empty">載入中…</p>
          </div>
        </div>

        <!-- ----- 側欄 sticky 儀表板 ----- -->
        <aside class="vote-sidebar">
          <div class="sidebar-block sidebar-block--countdown">
            <div class="sidebar-block__label">距結算</div>
            <div class="sidebar-block__big" id="countdown-days">—</div>
            <div class="sidebar-block__hint" id="countdown-when">每週日 23:59 結算</div>
          </div>

          <div class="sidebar-block">
            <div class="sidebar-block__label">我的投票</div>
            <div id="my-vote-status" class="my-vote-status">載入中…</div>
          </div>

          <div class="sidebar-block">
            <div class="sidebar-block__label">
              準備中
              <span class="sidebar-block__count" id="sidebar-scheduled-count"></span>
            </div>
            <ul id="sidebar-scheduled" class="sidebar-list">
              <li class="sidebar-list__empty">—</li>
            </ul>
          </div>

          <div class="sidebar-block">
            <div class="sidebar-block__label">
              已完成
              <span class="sidebar-block__count" id="sidebar-shipped-count"></span>
            </div>
            <ul id="sidebar-shipped" class="sidebar-list">
              <li class="sidebar-list__empty">—</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- ============== 提案 tab ============== -->
    <section id="tab-propose" class="wishlist-section" hidden>
      <p class="wishlist-intro">
        想看到什麼 skill ?提出來讓大家投票。新提案會經過審核才進入投票池。
      </p>
      <div class="propose-form">
        <div class="form-group">
          <label for="propose-title">Skill 名稱 <span class="form-hint">最多 100 字</span></label>
          <input type="text" id="propose-title" maxlength="100" placeholder="例:airbnb-comparator" />
        </div>
        <div class="form-group">
          <label for="propose-desc">想解決什麼問題 <span class="form-hint">最多 500 字</span></label>
          <textarea id="propose-desc" maxlength="500" rows="5" placeholder="說明這個 skill 想做什麼、為什麼有用"></textarea>
        </div>
        <button type="button" class="btn-download btn-download--large" id="propose-submit">送出提案</button>
      </div>
    </section>

    <!-- ============== 歷史結果 tab ============== -->
    <section id="tab-results" class="wishlist-section" hidden>
      <div id="results-list">
        <p class="empty">載入中…</p>
      </div>
    </section>

    <div class="toast" id="toast"></div>
  </div>
</Layout>

<style>
  /* ──────────────────────────────────────────────────────────
     Wishlist · 靜態模板樣式(scoped)

     注意:JS 動態渲染的 class(.wishlist-card / .vote-cta /
     .new-badge / .gap-badge / .vote-bar / .top-divider /
     .empty-vote / .my-vote-status / .sidebar-list /
     .results-week / .toast)在 global.css —— scoped style
     hash 拿不到 innerHTML 注入的元素。

     此處只放模板 hardcode 的靜態元素樣式。
     ────────────────────────────────────────────────────────── */

  .wishlist-section { display: block; }
  .wishlist-section[hidden] { display: none; }

  /* ----- 排序切換列(toolbar 靜態) ----- */
  .vote-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .vote-toolbar[hidden] { display: none; }
  .vote-toolbar__hint {
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
  }
  .vote-toolbar__sort { display: flex; gap: var(--space-xs); }

  .sort-btn {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-ink-faint);
    padding: 4px var(--space-sm);
    cursor: pointer;
    border-radius: 3px;
    transition: all 0.15s ease;
  }
  .sort-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-ink-muted);
  }
  .sort-btn.is-active {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  /* ----- 兩欄 layout(主欄 + sticky sidebar) ----- */
  .vote-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: var(--space-xl);
    align-items: start;
  }
  .vote-main { min-width: 0; /* 防止 grid item 撐爆 */ }

  .vote-sidebar {
    position: sticky;
    top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-height: calc(100vh - 2 * var(--space-lg));
    overflow-y: auto;
    padding-right: 4px;
  }

  /* ----- Sidebar 各 block(容器靜態,內容由 JS 渲染) ----- */
  .sidebar-block {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: var(--space-md);
  }
  .sidebar-block--countdown {
    background: var(--color-paper-dim);
    border-color: var(--color-line);
  }

  .sidebar-block__label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink-faint);
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .sidebar-block__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .sidebar-block__big {
    font-family: var(--font-mono);
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .sidebar-block__hint {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    line-height: 1.4;
  }

  /* ----- 提案 form ----- */
  .wishlist-intro {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }
  .propose-form {
    background: var(--color-paper-dim);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: var(--space-lg);
    max-width: 42rem;
  }
  .form-group { margin-bottom: var(--space-md); }
  .form-group label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }
  .form-hint {
    color: var(--color-ink-faint);
    font-weight: 400;
    font-size: 0.75rem;
    margin-left: 0.5em;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.5rem var(--space-md);
    transition: border-color 0.15s ease;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-ink);
  }
  .form-group textarea {
    resize: vertical;
    line-height: 1.55;
    font-family: var(--font-body);
  }

  /* ----- Tab 切換的 active 樣式(用 data-tab 限縮覆寫) ----- */
  .filter-btn[data-tab].is-active {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  /* ----- Responsive ----- */
  @media (max-width: 960px) {
    .vote-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .vote-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
    .sidebar-block--countdown { grid-column: span 1; }
    .sidebar-block__big { font-size: 1.5rem; }
  }
  @media (max-width: 720px) {
    .vote-toolbar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }
    .vote-sidebar { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initWishlist } from '../lib/wishlist-client';

  // GAS Web App URL — 換 deployment 改這條。
  initWishlist({
    gasUrl: 'https://script.google.com/macros/s/AKfycbwT7rtATWzPaQElJqhzhmwMktF173-4V20qcKgh8ncXqLeGlhS3Sa9HdHEIBz9btbwV/exec',
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/skills.generated.json';
import type { SkillMeta } from '../../types';
import { renderMarkdown, extractToc } from '../../lib/markdown';

export function getStaticPaths() {
  const skills = (catalog.skills as SkillMeta[]) || [];
  return skills.map((skill) => ({
    params: { name: skill.name },
    props: { skill },
  }));
}

interface Props {
  skill: SkillMeta;
}

const { skill } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  planning: '規劃',
  writing: '寫作',
  review: '審查',
  summary: '沉澱',
  data: '資料',
  utility: '工具',
  domain: '領域',
};

function formatSize(bytes: number): string {
  if (bytes === 0) return '—';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function formatDate(iso: string): string {
  if (!iso) return '';
  return new Date(iso).toISOString().slice(0, 10);
}

const BASE = import.meta.env.BASE_URL;

// 渲染 SKILL.md body — 在詳情頁脈絡下,references/xxx.md 連到 ./ref/{slug}
const renderedBody = renderMarkdown(skill.body, { refLinkPrefix: './ref/' });
const toc = extractToc(renderedBody);

// changelog 為自由格式 markdown,直接 render。
// build-catalog 已剝掉開頭 # Changelog 標題,避免雙標題。
const renderedChangelog = skill.changelog ? renderMarkdown(skill.changelog) : '';

// 第一行 description 當 pitch
const pitch = skill.description.split('\n')[0].trim();

// At a glance 區塊是否要顯示(有任一資料才顯示)
const hasAtGlance =
  skill.atGlance.triggerKeywords ||
  skill.atGlance.doNotTrigger ||
  skill.atGlance.gotchaTitles.length > 0 ||
  (skill.related && skill.related.length > 0);
---

<Layout title={skill.name} description={pitch}>
  <div class="container">
    <a href={BASE} class="detail-back">← back to index</a>

    {/* ─────────────────────────────── Hero ─────────────────────────────── */}
    <section class="hero-detail">
      <div class="hero-detail__head">
        <span class={`cat-badge cat-${skill.category}`}>{CATEGORY_LABELS[skill.category]}</span>
        <span class="hero-detail__version">v{skill.version}</span>
        <span class="hero-detail__date">更新於 {formatDate(skill.lastModified)}</span>
        <span class="hero-detail__commit mono">{skill.commitHash}</span>
      </div>

      <h1 class="hero-detail__title">{skill.name}</h1>
      <p class="hero-detail__pitch">{pitch}</p>

      <div class="hero-detail__cta">
        <a
          href={`${BASE}downloads/${skill.zipFilename}`}
          class="btn-download btn-download--large"
          download
        >
          ↓ Download .zip
          <span class="btn-download__size">{formatSize(skill.zipSize)}</span>
        </a>
        <a href={`${BASE}install`} class="btn-secondary">
          一行指令安裝 →
        </a>
      </div>

      {skill.tags && skill.tags.length > 0 && (
        <div class="hero-detail__tags">
          {skill.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
    </section>

    {/* ─────────────────────────────── At a glance ─────────────────────────────── */}
    {hasAtGlance && (
      <section class="at-glance">
        <h2 class="section-heading">At a glance</h2>
        <div class="at-glance__grid">
          {skill.atGlance.triggerKeywords && (
            <div class="at-glance__card">
              <div class="at-glance__card-title">何時觸發</div>
              <p class="at-glance__card-body">{skill.atGlance.triggerKeywords}</p>
            </div>
          )}

          {skill.atGlance.doNotTrigger && (
            <div class="at-glance__card at-glance__card--neg">
              <div class="at-glance__card-title">不適用情境</div>
              <p class="at-glance__card-body">{skill.atGlance.doNotTrigger}</p>
            </div>
          )}

          {skill.atGlance.gotchaTitles.length > 0 && (
            <div class="at-glance__card at-glance__card--warn">
              <div class="at-glance__card-title">常見踩雷 ({skill.atGlance.gotchaTitles.length})</div>
              <ul class="at-glance__gotcha-list">
                {skill.atGlance.gotchaTitles.slice(0, 6).map((g) => (
                  <li>{g}</li>
                ))}
              </ul>
              {skill.atGlance.gotchaTitles.length > 6 && (
                <a href="#gotchas" class="at-glance__more">看完整 →</a>
              )}
            </div>
          )}

          {skill.related && skill.related.length > 0 && (
            <div class="at-glance__card">
              <div class="at-glance__card-title">相關 skill</div>
              <ul class="at-glance__related-list">
                {skill.related.map((rel) => (
                  <li><a href={`${BASE}skill/${rel}`}>{rel}</a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {/* ─────────────────────────────── How it works + sticky TOC ─────────────────────────────── */}
    <section class="how-it-works">
      <h2 class="section-heading">How it works</h2>
      <div class="how-it-works__layout">
        {toc.length > 0 && (
          <aside class="toc">
            <div class="toc__label">目錄</div>
            <ul class="toc__list">
              {toc.filter((t) => t.level === 2).map((t) => (
                <li>
                  <a href={`#${t.id}`}>{t.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
        <article class="skill-body" set:html={renderedBody}></article>
      </div>
    </section>

    {/* ─────────────────────────────── References ─────────────────────────────── */}
    {skill.references && skill.references.length > 0 && (
      <section class="references-section">
        <h2 class="section-heading">Reference files ({skill.references.length})</h2>
        <p class="references-section__intro">
          這個 skill 採用 progressive disclosure 設計,主要邏輯在上方 SKILL.md,
          下列為按需載入的 references。
        </p>
        <ul class="ref-list">
          {skill.references.map((ref) => (
            <li class="ref-list__item">
              <a href={`${BASE}skill/${skill.name}/ref/${ref.slug}`} class="ref-list__link">
                <div class="ref-list__filename">
                  <span class="mono">references/{ref.filename}</span>
                  <span class="ref-list__arrow">→</span>
                </div>
                {ref.firstLine && (
                  <div class="ref-list__preview">{ref.firstLine}</div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ─────────────────────────────── Changelog ─────────────────────────────── */}
    {renderedChangelog && (
      <section class="changelog-section">
        <h2 class="section-heading">Changelog</h2>
        <article class="changelog-body" set:html={renderedChangelog}></article>
      </section>
    )}

    {/* ─────────────────────────────── Install ─────────────────────────────── */}
    <section class="install-section">
      <h2 class="section-heading">Install</h2>
      <div class="install-box">
        <div class="install-box__title">three steps</div>
        <ol>
          <li>下載 <code>{skill.zipFilename}</code></li>
          <li>解壓縮,把 <code>{skill.name}/</code> 整個資料夾放到 <code>~/.claude/skills/</code></li>
          <li>重啟 Claude</li>
        </ol>
        {skill.related && skill.related.length > 0 && (
          <p style="margin-top: 1rem; font-size: 0.875rem; color: var(--color-ink-muted);">
            提醒:本 skill 引用了 <strong>{skill.related.join(', ')}</strong>,建議一起安裝。
          </p>
        )}
      </div>
    </section>
  </div>
</Layout>

<script>
  // sticky TOC: 捲動時高亮當前章節
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc__list a');
  if (tocLinks.length > 0) {
    const headings = document.querySelectorAll<HTMLElement>('.skill-body h2[id]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((a) => {
              a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`);
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>

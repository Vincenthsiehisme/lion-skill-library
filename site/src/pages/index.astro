---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/skills.generated.json';
import type { SkillMeta } from '../types';

const CATEGORY_LABELS: Record<string, string> = {
  planning: '規劃',
  writing: '寫作',
  review: '審查',
  summary: '沉澱',
  data: '資料',
  utility: '工具',
  domain: '領域',
};

const skills = catalog.skills as SkillMeta[];

// 計算每個 category 的數量
const categoryCount: Record<string, number> = {};
for (const s of skills) {
  categoryCount[s.category] = (categoryCount[s.category] || 0) + 1;
}

const categories = Object.keys(CATEGORY_LABELS).filter((c) => categoryCount[c] > 0);

function formatSize(bytes: number): string {
  if (bytes === 0) return '—';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function formatDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toISOString().slice(0, 10);
}

const totalCount = skills.length;
const generatedAt = catalog.generatedAt ? formatDate(catalog.generatedAt) : '';
const BASE = import.meta.env.BASE_URL;
const SITE = 'https://vincenthsiehisme.github.io/lion-skill-library';
---

<Layout>
  <div class="container">
    <section class="hero">
      <div class="hero__kicker">A reference index for AI workflows</div>
      <h1 class="hero__title">
        Claude Skills, curated for the team.
      </h1>
      <p class="hero__sub">
        每個 Skill 是一組指令 + 參考檔案。安裝後，Claude 會在對應情境自動觸發。
        下載 zip、放進 <code>~/.claude/skills/</code>、重啟 Claude — 完成。
      </p>
      <div class="hero__meta">
        <span><strong>{totalCount}</strong> skills indexed</span>
        <span>Last build · <strong>{generatedAt}</strong></span>
        <span>Internal · MIT-licensed</span>
      </div>
    </section>

    {totalCount === 0 ? (
      <div class="empty">
        <p>目錄目前為空。第一個 Skill 上架後會自動出現在這裡。</p>
        <p style="margin-top: 1rem; font-family: var(--font-mono); font-size: 0.875rem;">
          maintainer note: push a folder under <code>skills/</code> to populate.
        </p>
      </div>
    ) : (
      <>
        <div class="filter-bar" role="tablist" aria-label="Filter by category">
          <button
            type="button"
            class="filter-btn is-active"
            data-filter="all"
            role="tab"
            aria-selected="true"
          >
            All<span class="filter-btn__count">{totalCount}</span>
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              class="filter-btn"
              data-filter={cat}
              role="tab"
              aria-selected="false"
            >
              {CATEGORY_LABELS[cat]}<span class="filter-btn__count">{categoryCount[cat]}</span>
            </button>
          ))}
        </div>

        <ul class="skill-grid" id="skill-list">
          {skills.map((skill) => {
            // description 太長截斷
            const shortDesc =
              skill.description.length > 180
                ? skill.description.slice(0, 180) + '…'
                : skill.description;

            return (
              <li class="skill-card" data-category={skill.category}>
                <h2 class="skill-card__title">
                  <a href={`${BASE}skill/${skill.name}`}>{skill.name}</a>
                </h2>
                <p class="skill-card__desc">{shortDesc}</p>
                <div class="skill-card__meta">
                  <span class={`cat-badge cat-${skill.category}`}>
                    {CATEGORY_LABELS[skill.category]}
                  </span>
                  <span>v{skill.version}</span>
                  <span>{formatDate(skill.lastModified)}</span>
                </div>
                <div class="skill-card__actions">
                  <span class="skill-card__version">
                    {skill.tags && skill.tags.length > 0 ? skill.tags.slice(0, 2).join(' / ') : ''}
                  </span>
                  <a
                    href={`${BASE}downloads/${skill.zipFilename}`}
                    class="btn-download"
                    download
                  >
                    ↓ Download
                    <span class="btn-download__size">{formatSize(skill.zipSize)}</span>
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
      </>
    )}

    <section id="how-to-install" style="margin-top: 6rem; padding-top: 3rem; border-top: 1px solid var(--color-line);">
      <h2 style="margin-bottom: 0.5rem;">How to install</h2>
      <p style="color: var(--color-ink-muted); margin-bottom: 2rem;">
        兩條路:用 Claude Code 一行指令最快;手動下載 zip 適合任何 Claude 版本。
      </p>

      <div class="install-routes">
        <!-- 路 A:腳本 -->
        <div class="install-route">
          <div class="install-route__head">
            <span class="install-route__badge">路 A</span>
            <span class="install-route__title">一行指令 · Claude Code</span>
          </div>
          <p class="install-route__sub">最快路徑。打開 terminal,貼:</p>
          <pre class="install-route__code"><code>curl -fsSL {SITE}/install.sh | bash -s -- install &lt;name&gt;</code></pre>
          <p class="install-route__sub" style="margin-top: 0.75rem;">列出可裝清單:</p>
          <pre class="install-route__code"><code>curl -fsSL {SITE}/install.sh | bash -s -- list</code></pre>
          <p class="install-route__note">
            支援 macOS / Linux。Windows PowerShell 版本準備中。
          </p>
        </div>

        <!-- 路 B:手動 -->
        <div class="install-route">
          <div class="install-route__head">
            <span class="install-route__badge">路 B</span>
            <span class="install-route__title">手動下載 zip · 任何版本</span>
          </div>
          <p class="install-route__sub">適合 Windows、Claude.ai 網頁版,或不想跑 curl。</p>
          <ol class="install-route__steps">
            <li>從上方列表點 <strong>Download</strong> 拿到 <code>.zip</code></li>
            <li>解壓出來的資料夾放到:
              <ul>
                <li>macOS / Linux: <code>~/.claude/skills/</code></li>
                <li>Windows: <code>%USERPROFILE%\.claude\skills\</code></li>
                <li>Claude.ai: 到 Settings → Capabilities → Skills 上傳</li>
              </ul>
            </li>
            <li>重啟 Claude</li>
          </ol>
        </div>
      </div>

      <p class="install-routes__more">
        <a href={`${BASE}install`}>→ 完整教學</a>
        <span style="color: var(--color-ink-faint);">(含 Claude Code 安裝步驟、所有指令選項、FAQ)</span>
      </p>
    </section>
  </div>
</Layout>

<script>
  // 篩選邏輯：純 vanilla，無框架依賴
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.skill-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      if (!filter) return;

      filterBtns.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      cards.forEach((card) => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.dataset.hidden = 'false';
        } else {
          card.dataset.hidden = 'true';
        }
      });
    });
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/skills.generated.json';
import type { SkillMeta } from '../types';

const CATEGORY_LABELS: Record<string, string> = {
  planning: '規劃',
  writing: '寫作',
  review: '審查',
  summary: '沉澱',
  data: '資料',
  utility: '工具',
  domain: '領域',
};

const skills = catalog.skills as SkillMeta[];

// 計算每個 category 的數量
const categoryCount: Record<string, number> = {};
for (const s of skills) {
  categoryCount[s.category] = (categoryCount[s.category] || 0) + 1;
}

const categories = Object.keys(CATEGORY_LABELS).filter((c) => categoryCount[c] > 0);

function formatSize(bytes: number): string {
  if (bytes === 0) return '—';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function formatDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toISOString().slice(0, 10);
}

const totalCount = skills.length;
const generatedAt = catalog.generatedAt ? formatDate(catalog.generatedAt) : '';
const BASE = import.meta.env.BASE_URL;

// ─────────────────────────────────────────────────────────────
// Common tasks: hardcode 的「卡情境」入口
// 對應到 skill 必須存在於 catalog,否則跳過該 task(避免死連結)
// ─────────────────────────────────────────────────────────────
const COMMON_TASKS: Array<{ task: string; skill: string; blurb: string }> = [
  { task: '我要寫 PRD',            skill: 'prd-writer',       blurb: '結構化問診 + 模糊探索前置階段' },
  { task: '我要審方案 / 找盲點',     skill: 'critical-reviewer', blurb: '麥肯錫式批判,顧問小組視角' },
  { task: '我要拆 sprint 任務',     skill: 'task-dispatcher',   blurb: '偵測 Squad 範疇,輸出分工表' },
  { task: '我要看資料 / 分析 CSV', skill: 'data-lens-proposer', blurb: '替身分析師,N 種切法擋會議提問' },
  { task: '我要查雄獅系統',         skill: 'group-system-advisor', blurb: '控制域歸因、改動影響範圍盤點' },
  { task: '我要結束對話交接',       skill: 'session-handoff',   blurb: '把脈絡濃縮成結構化交接文件' },
];
const skillNames = new Set(skills.map((s) => s.name));
const visibleTasks = COMMON_TASKS.filter((t) => skillNames.has(t.skill));

// ─────────────────────────────────────────────────────────────
// Recent · 兩條時間軸
// - 新發布:firstPublished 在 14 天內
// - 新版本:versionBumpedAt 在 14 天內,且不在新發布清單裡(避免雙重出現)
// 各取最近 5 個。任一邊空就整邊不顯示;兩邊都空整段不顯示。
// ─────────────────────────────────────────────────────────────
const RECENT_WINDOW_DAYS = 14;
const RECENT_LIMIT = 5;
const now = Date.now();
const windowMs = RECENT_WINDOW_DAYS * 24 * 60 * 60 * 1000;

function withinWindow(iso: string): boolean {
  if (!iso) return false;
  const t = new Date(iso).getTime();
  return Number.isFinite(t) && now - t <= windowMs;
}

function daysAgo(iso: string): string {
  const ms = now - new Date(iso).getTime();
  const days = Math.floor(ms / (24 * 60 * 60 * 1000));
  if (days <= 0) return '今天';
  if (days === 1) return '昨天';
  if (days < 7) return `${days} 天前`;
  const weeks = Math.floor(days / 7);
  return `${weeks} 週前`;
}

const newReleases = skills
  .filter((s) => withinWindow(s.firstPublished))
  .sort((a, b) => (a.firstPublished < b.firstPublished ? 1 : -1))
  .slice(0, RECENT_LIMIT);

const newReleaseNames = new Set(newReleases.map((s) => s.name));

const newVersions = skills
  .filter(
    (s) =>
      withinWindow(s.versionBumpedAt) &&
      // 排除已在新發布清單的（避免同一個 skill 雙重出現）
      !newReleaseNames.has(s.name) &&
      // 排除「versionBumpedAt 等於 firstPublished」的情況
      // (因為這代表 version 從沒 bump 過,只是初始 commit)
      s.versionBumpedAt !== s.firstPublished,
  )
  .sort((a, b) => (a.versionBumpedAt < b.versionBumpedAt ? 1 : -1))
  .slice(0, RECENT_LIMIT);

const showRecent = newReleases.length > 0 || newVersions.length > 0;
---

<Layout>
  <div class="container">
    <section class="hero">
      <div class="hero__kicker">A reference index for AI workflows</div>
      <h1 class="hero__title">
        Claude Skills, curated for the team.
      </h1>
      <p class="hero__sub">
        每個 Skill 是一組指令 + 參考檔案。安裝後，Claude 會在對應情境自動觸發。
        下載 zip、放進 <code>~/.claude/skills/</code>、重啟 Claude — 完成。
      </p>
      <p class="hero__install-hint">
        完整教學、Claude Code 安裝、常見問題 → <a href={`${BASE}install`}>安裝教學</a>
      </p>
      <div class="hero__meta">
        <span><strong>{totalCount}</strong> skills indexed</span>
        <span>Last build · <strong>{generatedAt}</strong></span>
        <span>Internal · MIT-licensed</span>
      </div>
    </section>

    {totalCount === 0 ? (
      <div class="empty">
        <p>目錄目前為空。第一個 Skill 上架後會自動出現在這裡。</p>
        <p style="margin-top: 1rem; font-family: var(--font-mono); font-size: 0.875rem;">
          maintainer note: push a folder under <code>skills/</code> to populate.
        </p>
      </div>
    ) : (
      <>
        <!-- ─────────────────────────────────────────────────────────
             What is this · 給「完全不懂的人」的著陸區
             ───────────────────────────────────────────────────────── -->
        <section class="explainer">
          <div class="explainer__label">什麼是 Skill？</div>
          <p class="explainer__body">
            一組給 Claude 看的指令 + 參考檔案。安裝後，Claude 會在符合條件的對話情境自動觸發，
            用設計好的方式回應 — 不需要每次對話都重新解釋。
          </p>
          <p class="explainer__example">
            例如裝了 <code>prd-writer</code>，跟 Claude 說「幫我寫一份 PRD」，
            它會自動跑結構化的問診流程，而不是亂寫一份。
          </p>
          <div class="explainer__cta">
            <a href={`${BASE}about`}>了解更多 →</a>
            <a href={`${BASE}install`}>安裝教學 →</a>
          </div>
        </section>

        <!-- ─────────────────────────────────────────────────────────
             Common tasks · 給「卡情境的人」的快速入口
             ───────────────────────────────────────────────────────── -->
        {visibleTasks.length > 0 && (
          <section class="tasks">
            <div class="tasks__header">
              <h2 class="tasks__title">常見任務</h2>
              <span class="tasks__hint">不確定要找什麼？從這裡開始</span>
            </div>
            <ul class="tasks__grid">
              {visibleTasks.map((t) => (
                <li>
                  <a href={`${BASE}skill/${t.skill}`} class="task-card">
                    <div class="task-card__task">{t.task}</div>
                    <div class="task-card__skill"><code>{t.skill}</code></div>
                    <div class="task-card__blurb">{t.blurb}</div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- ─────────────────────────────────────────────────────────
             Recent · 給「回訪的人」的雙線時間軸
             ───────────────────────────────────────────────────────── -->
        {showRecent && (
          <section class="recent">
            <div class="recent__header">
              <h2 class="recent__title">最近動態</h2>
              <span class="recent__hint">{RECENT_WINDOW_DAYS} 天內的變化</span>
            </div>
            <div class="recent__cols">
              {newReleases.length > 0 && (
                <div class="recent__col">
                  <div class="recent__col-label">新發布</div>
                  <ul class="recent__list">
                    {newReleases.map((s) => (
                      <li>
                        <a href={`${BASE}skill/${s.name}`} class="recent-item">
                          <span class="recent-item__name">{s.name}</span>
                          <span class="recent-item__meta">
                            <span class="recent-item__when">{daysAgo(s.firstPublished)}</span>
                            <span class="recent-item__sep">·</span>
                            <span class="recent-item__version">v{s.version}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {newVersions.length > 0 && (
                <div class="recent__col">
                  <div class="recent__col-label">新版本</div>
                  <ul class="recent__list">
                    {newVersions.map((s) => (
                      <li>
                        <a href={`${BASE}skill/${s.name}`} class="recent-item">
                          <span class="recent-item__name">{s.name}</span>
                          <span class="recent-item__meta">
                            <span class="recent-item__when">{daysAgo(s.versionBumpedAt)}</span>
                            <span class="recent-item__sep">·</span>
                            <span class="recent-item__version">v{s.version}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- ─────────────────────────────────────────────────────────
             完整目錄(原有結構)
             ───────────────────────────────────────────────────────── -->
        <section class="catalog">
          <div class="catalog__header">
            <h2 class="catalog__title">完整目錄</h2>
            <span class="catalog__hint">已知目標時,直接搜尋或篩選</span>
          </div>

          <div class="search-bar">
            <div class="search-input-wrap">
              <span class="search-input-icon" aria-hidden="true">⌕</span>
              <input
                type="search"
                id="skill-search"
                class="search-input"
                placeholder="搜尋 skill 名稱、描述或 tag…"
                autocomplete="off"
                spellcheck="false"
                aria-label="搜尋 skill"
              />
            </div>
            <button
              type="button"
              id="clear-filters"
              class="btn-clear-filters"
              hidden
              aria-label="清除搜尋與所有篩選"
            >
              Clear all
            </button>
          </div>

          <div class="filter-bar" role="tablist" aria-label="Filter by category">
            <button
              type="button"
              class="filter-btn is-active"
              data-filter="all"
              role="tab"
              aria-selected="true"
            >
              All<span class="filter-btn__count">{totalCount}</span>
            </button>
            {categories.map((cat) => (
              <button
                type="button"
                class="filter-btn"
                data-filter={cat}
                role="tab"
                aria-selected="false"
              >
                {CATEGORY_LABELS[cat]}<span class="filter-btn__count">{categoryCount[cat]}</span>
              </button>
            ))}
          </div>

          <ul class="skill-grid" id="skill-list">
            {skills.map((skill) => {
              // description 太長截斷
              const shortDesc =
                skill.description.length > 180
                  ? skill.description.slice(0, 180) + '…'
                  : skill.description;

              return (
                <li
                  class="skill-card"
                  data-category={skill.category}
                  data-name={skill.name.toLowerCase()}
                  data-tags={(skill.tags || []).join(' ').toLowerCase()}
                  data-search-text={skill.description.toLowerCase()}
                >
                  <h2 class="skill-card__title">
                    <a href={`${BASE}skill/${skill.name}`}>{skill.name}</a>
                  </h2>
                  <p class="skill-card__desc">{shortDesc}</p>
                  <div class="skill-card__meta">
                    <span class={`cat-badge cat-${skill.category}`}>
                      {CATEGORY_LABELS[skill.category]}
                    </span>
                    <span>v{skill.version}</span>
                    <span>{formatDate(skill.lastModified)}</span>
                  </div>
                  <div class="skill-card__actions">
                    <span class="skill-card__version">
                      {skill.tags && skill.tags.length > 0 ? skill.tags.slice(0, 2).join(' / ') : ''}
                    </span>
                    <a
                      href={`${BASE}downloads/${skill.zipFilename}`}
                      class="btn-download"
                      download
                    >
                      ↓ Download
                      <span class="btn-download__size">{formatSize(skill.zipSize)}</span>
                    </a>
                  </div>
                </li>
              );
            })}
          </ul>

          <div id="empty-result" class="empty-result" hidden>
            <p>沒找到符合 "<span id="empty-result-query"></span>" 的 skill。</p>
            <p class="empty-result__hint">試試其他關鍵字，或 <button type="button" id="empty-result-clear" class="link-button">瀏覽全部</button>。</p>
          </div>
        </section>
      </>
    )}
  </div>
</Layout>

<script>
  // 篩選邏輯:純 vanilla,無框架依賴
  // 行為規格:
  //   - filter 多選:點分類 = toggle、點 All = 清空所有分類選擇
  //   - search:搜 name + description + tags,即時過濾
  //   - filter Set 與 search query 是 AND 關係(同時收窄)
  //   - 結果為 0 顯示 empty-result,Clear all 在「filter 有選 或 search 有字」時顯示
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.skill-card');
  const searchInput = document.getElementById('skill-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement | null;
  const emptyResult = document.getElementById('empty-result');
  const emptyResultQuery = document.getElementById('empty-result-query');
  const emptyResultClear = document.getElementById('empty-result-clear') as HTMLButtonElement | null;
  const skillList = document.getElementById('skill-list');

  // state
  const activeFilters = new Set<string>(); // 空 Set = All(不過濾分類)
  let searchQuery = '';

  function applyFilters(): void {
    const q = searchQuery.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const cat = card.dataset.category || '';
      const name = card.dataset.name || '';
      const tags = card.dataset.tags || '';
      const desc = card.dataset.searchText || '';

      const categoryMatch = activeFilters.size === 0 || activeFilters.has(cat);
      const searchMatch =
        q === '' || name.includes(q) || desc.includes(q) || tags.includes(q);

      const visible = categoryMatch && searchMatch;
      card.dataset.hidden = visible ? 'false' : 'true';
      if (visible) visibleCount++;
    });

    if (emptyResult && emptyResultQuery && skillList) {
      if (visibleCount === 0) {
        emptyResultQuery.textContent = q !== '' ? q : '(目前篩選條件)';
        emptyResult.hidden = false;
        skillList.style.display = 'none';
      } else {
        emptyResult.hidden = true;
        skillList.style.display = '';
      }
    }

    if (clearBtn) {
      const hasFilter = activeFilters.size > 0;
      const hasQuery = q !== '';
      clearBtn.hidden = !(hasFilter || hasQuery);
    }

    filterBtns.forEach((b) => {
      const f = b.dataset.filter || '';
      const isActive =
        (f === 'all' && activeFilters.size === 0) ||
        (f !== 'all' && activeFilters.has(f));
      b.classList.toggle('is-active', isActive);
      b.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      if (!filter) return;

      if (filter === 'all') {
        activeFilters.clear();
      } else {
        if (activeFilters.has(filter)) {
          activeFilters.delete(filter);
        } else {
          activeFilters.add(filter);
        }
      }

      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      applyFilters();
    });
  }

  function resetAll(): void {
    activeFilters.clear();
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    applyFilters();
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', resetAll);
  }
  if (emptyResultClear) {
    emptyResultClear.addEventListener('click', resetAll);
  }

  applyFilters();
</script>

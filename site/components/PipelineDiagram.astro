---
/**
 * Pipeline 視覺化:把 group 內的 feeds_into 關係畫成簡單的有向圖。
 *
 * 設計取捨:
 *   - 不用 graph layout library(會塞超大 bundle)
 *   - 用「拓撲排序分層」做最簡 layout:沒有 consumes_from 的當第 0 層(源頭),
 *     後面每層 = 上一層 feeds_into 指向的節點
 *   - 同層水平排列,層間垂直,箭頭從上層連到下層
 *   - 純 SVG + CSS,點節點跳該 skill 詳情頁
 *
 * 邊界:節點數 >= 3 才畫;否則卡片列表本身已經夠看,畫圖反而增加噪音。
 */
import type { SkillMeta } from '../types';

interface Props {
  skills: SkillMeta[];
  baseUrl: string;
}

const { skills, baseUrl } = Astro.props;

// ─────────────────────────────────────────────────────────────
// 拓撲排序分層
// ─────────────────────────────────────────────────────────────
const nameToSkill = new Map(skills.map((s) => [s.name, s]));
const inGroupNames = new Set(skills.map((s) => s.name));

// 只看 group 內部關係(指向 group 外的邊忽略)
function inGroupFeeds(s: SkillMeta): string[] {
  return (s.feeds_into || []).filter((n) => inGroupNames.has(n));
}
function inGroupConsumes(s: SkillMeta): string[] {
  return (s.consumes_from || []).filter((n) => inGroupNames.has(n));
}

// 第 0 層:沒人餵我(consumes_from 為空)
const layers: string[][] = [];
const assigned = new Set<string>();

function isSource(s: SkillMeta): boolean {
  return inGroupConsumes(s).length === 0;
}

// Layer 0
const layer0 = skills.filter(isSource).map((s) => s.name).sort();
if (layer0.length > 0) {
  layers.push(layer0);
  layer0.forEach((n) => assigned.add(n));
}

// 後續層:節點所有 consumes_from 都已分配時,可放入下一層
let safetyBreak = 10;
while (assigned.size < skills.length && safetyBreak-- > 0) {
  const nextLayer = skills
    .filter((s) => !assigned.has(s.name))
    .filter((s) => inGroupConsumes(s).every((c) => assigned.has(c)))
    .map((s) => s.name)
    .sort();
  if (nextLayer.length === 0) break; // 有環,跳出
  layers.push(nextLayer);
  nextLayer.forEach((n) => assigned.add(n));
}

// 未分配到層的(理論上是環)就統一放最後一層
if (assigned.size < skills.length) {
  const orphans = skills
    .filter((s) => !assigned.has(s.name))
    .map((s) => s.name);
  if (orphans.length > 0) layers.push(orphans);
}

// ─────────────────────────────────────────────────────────────
// 計算 SVG 座標
// ─────────────────────────────────────────────────────────────
const NODE_W = 140;
const NODE_H = 36;
const LAYER_GAP_Y = 70;
const NODE_GAP_X = 24;
const PAD = 16;

const layerWidths = layers.map((l) => l.length * NODE_W + (l.length - 1) * NODE_GAP_X);
const maxWidth = Math.max(...layerWidths, 0);
const svgWidth = maxWidth + PAD * 2;
const svgHeight = layers.length * NODE_H + (layers.length - 1) * LAYER_GAP_Y + PAD * 2;

// name → {x, y}
const nodePos = new Map<string, { x: number; y: number }>();
layers.forEach((layer, layerIdx) => {
  const layerWidth = layer.length * NODE_W + (layer.length - 1) * NODE_GAP_X;
  const startX = (svgWidth - layerWidth) / 2;
  layer.forEach((name, nodeIdx) => {
    const x = startX + nodeIdx * (NODE_W + NODE_GAP_X);
    const y = PAD + layerIdx * (NODE_H + LAYER_GAP_Y);
    nodePos.set(name, { x, y });
  });
});

// 邊清單(group 內 feeds_into)
const edges: Array<{ from: string; to: string }> = [];
for (const s of skills) {
  for (const target of inGroupFeeds(s)) {
    edges.push({ from: s.name, to: target });
  }
}

// 邊路徑:從來源節點底部中央 → 目標節點頂部中央,中段曲線
function edgePath(fromName: string, toName: string): string {
  const a = nodePos.get(fromName);
  const b = nodePos.get(toName);
  if (!a || !b) return '';
  const x1 = a.x + NODE_W / 2;
  const y1 = a.y + NODE_H;
  const x2 = b.x + NODE_W / 2;
  const y2 = b.y;
  const midY = (y1 + y2) / 2;
  return `M ${x1} ${y1} C ${x1} ${midY}, ${x2} ${midY}, ${x2} ${y2}`;
}
---

<div class="pipeline-diagram" role="img" aria-label="Pipeline 關係圖">
  <svg
    width={svgWidth}
    height={svgHeight}
    viewBox={`0 0 ${svgWidth} ${svgHeight}`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <marker
        id="arrow-pipeline"
        markerWidth="10"
        markerHeight="10"
        refX="8"
        refY="3"
        orient="auto"
        markerUnits="strokeWidth"
      >
        <path d="M0,0 L0,6 L9,3 z" fill="currentColor" />
      </marker>
    </defs>

    {/* 邊先畫(放下面) */}
    {edges.map((e) => (
      <path
        d={edgePath(e.from, e.to)}
        class="pipeline-edge"
        fill="none"
        marker-end="url(#arrow-pipeline)"
      />
    ))}

    {/* 節點(放上面壓住箭頭尾) */}
    {skills.map((s) => {
      const pos = nodePos.get(s.name);
      if (!pos) return null;
      return (
        <a href={`${baseUrl}skill/${s.name}`} class="pipeline-node-link">
          <rect
            x={pos.x}
            y={pos.y}
            width={NODE_W}
            height={NODE_H}
            rx="4"
            ry="4"
            class="pipeline-node-rect"
          />
          <text
            x={pos.x + NODE_W / 2}
            y={pos.y + NODE_H / 2}
            class="pipeline-node-text"
            text-anchor="middle"
            dominant-baseline="central"
          >
            {s.name}
          </text>
        </a>
      );
    })}
  </svg>
</div>

<style>
  .pipeline-diagram {
    margin: var(--space-md) 0;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.015);
    border: 1px dashed var(--color-line);
    border-radius: 6px;
    overflow-x: auto;
  }

  .pipeline-diagram svg {
    display: block;
    max-width: 100%;
    height: auto;
    color: var(--color-ink-muted);
  }

  .pipeline-edge {
    stroke: var(--color-ink-muted);
    stroke-width: 1.5;
    opacity: 0.5;
  }

  .pipeline-node-rect {
    fill: var(--color-paper);
    stroke: var(--color-line);
    stroke-width: 1;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }

  .pipeline-node-link:hover .pipeline-node-rect {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }

  .pipeline-node-text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--color-ink);
    pointer-events: none;
    transition: fill 0.15s ease;
  }

  .pipeline-node-link:hover .pipeline-node-text {
    fill: var(--color-paper);
  }
</style>
